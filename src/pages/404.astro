---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page Not Found — Lakmuthu Studio"
	description="The requested page could not be found."
	noindex={true}
>
	<section class="error-page">
		<div class="wrap">
			<div class="error-shell">
				<span class="error-code" aria-hidden="true">404</span>
				<h1>That page isn’t here.</h1>
				<p>The address may be incorrect, or the page may have moved. You can return to the homepage or start a project inquiry.</p>
				<div class="hero-ctas" style="justify-content: center;">
					<a class="btn btn-primary" href="/">Back to home</a>
					<a class="btn btn-ghost" href="/#contact">Get in touch</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
