---
const demos = [
	{
		title: "Business Website Demo",
		description: "A complete multi-page hotel website with rooms, gallery, location information, and a safe customer inquiry flow.",
		goodFor: "hotels, clinics, restaurants, service providers, and other public-facing businesses.",
		image: "/images/business-website-demo.webp",
		caseStudy: "/work/business-website-demo/"
	},
	{
		title: "Landing Page Demo",
		description: "A polished online-course landing page that explains one offer clearly and guides visitors toward enrollment.",
		goodFor: "course launches, online programs, workshops, and education brands.",
		image: "/images/landing_demo.png",
		caseStudy: "/work/landing-page-demo/"
	},
	{
		title: "Admin Dashboard Demo",
		description: "A React admin panel for managing bookshop orders, customers, products, stock, reports, and business settings.",
		goodFor: "businesses that need internal tools, CRUD workflows, or a clearer alternative to spreadsheets.",
		image: "/images/admin-dashboard-demo.webp",
		caseStudy: "/work/admin-dashboard-demo/"
	},
	{
		title: "Web App Demo",
		description: "A first-version web application demo showing user workflows, database-backed features, forms, and admin-side management.",
		goodFor: "startup MVPs, booking systems, order systems, customer portals, internal tools.",
		image: "/images/mobile-app-demo.png"
	},
	{
		title: "Desktop / Internal Tool Demo",
		description: "A focused desktop or internal-tool demo for file processing, reporting, data handling, or offline workflows.",
		goodFor: "businesses or teams that need a local tool instead of a public website.",
		image: "/images/mobile-app-demo.png"
	}
];
---

<section id="work">
	<div class="wrap">
		<div class="section-head reveal">
			<span class="eyebrow">Work Examples</span>
			<h2>Demo projects showing what I can build</h2>
			<p>Demo projects showing the type of design, workflow, and software quality I can deliver.</p>
		</div>

		<div class="work-grid">
			{demos.map(demo => demo.caseStudy ? (
				<a class="work-card work-card-link reveal" href={demo.caseStudy} aria-label={`View the ${demo.title} case study`}>
					<div class="work-frame">
						<img src={demo.image} alt="" loading="lazy" />
					</div>
					<div class="work-body">
						<h3>{demo.title}</h3>
						<p>{demo.description}</p>
						<p style="margin-bottom: 16px; font-size: 0.88rem; color: var(--ink-soft);">
							<strong>Good for:</strong> {demo.goodFor}
						</p>
						<span class="work-link">View project details →</span>
					</div>
				</a>
			) : (
				<div class="work-card reveal">
					<div class="work-frame">
						<img src={demo.image} alt={demo.title} loading="lazy" />
					</div>
					<div class="work-body">
						<h3>{demo.title}</h3>
						<p>{demo.description}</p>
						<p style="margin-bottom: 16px; font-size: 0.88rem; color: var(--ink-soft);">
							<strong>Good for:</strong> {demo.goodFor}
						</p>
						<a href="#contact" class="work-link">Inquire about a similar build →</a>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
