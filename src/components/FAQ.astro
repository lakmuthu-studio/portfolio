---
const faqs = [
	{
		question: "Do you provide long-term maintenance?",
		answer: "Long-term maintenance is not included by default. I provide 30 days of post-launch bug-fix support for agreed-scope issues. If you need short transition support after launch, we can discuss it before handover."
	},
	{
		question: "Do I own the project?",
		answer: "Yes. After final payment, the agreed source code, project files, and handover documentation are transferred to you."
	},
	{
		question: "Are hosting and domain costs included?",
		answer: "No. Hosting, domain names, email, SMS, payment gateway fees, third-party APIs, app store fees, and similar external costs are separate from the development fee unless stated in the project proposal."
	},
	{
		question: "Can I request changes after approving the scope?",
		answer: "Yes, but changes outside the approved scope may require extra time and additional cost."
	},
	{
		question: "Can you build a full app?",
		answer: "Yes, but full products are usually built in phases. The first phase focuses on the core working version. Additional features can be quoted separately."
	},
	{
		question: "Can you work with an existing website or app?",
		answer: "Yes, depending on the technology, code quality, access, and project condition. I review existing projects before accepting repair, continuation, or rebuild work."
	},
	{
		question: "Do you use templates?",
		answer: "I build custom lightweight websites and applications based on the project requirements. For simple websites, I may use reusable layout patterns or components to keep the project efficient, but the final site is built around your business content and goals."
	},
	{
		question: "Which technologies do you use?",
		answer: "The technology depends on the project. I commonly work with modern web, backend, mobile, Linux, and desktop application technologies. The stack is selected based on project scope, maintainability, deployment needs, and long-term handover."
	},
	{
		question: "When does work start?",
		answer: "Work starts after the project scope is approved and the agreed advance payment is received."
	},
	{
		question: "When do I receive the source code?",
		answer: "The agreed source code and project files are transferred after final payment."
	}
];
---

<section id="faq">
	<div class="wrap">
		<div class="section-head reveal">
			<span class="eyebrow">FAQ</span>
			<h2>Frequently asked questions</h2>
			<p>Clear answers to common questions about ownership, scope changes, technology, and project workflows.</p>
		</div>

		<div class="faq-list">
			{faqs.map((faq, idx) => (
				<details class="faq-card reveal" open={idx === 0}>
					<summary class="faq-summary">
						<span>{faq.question}</span>
						<span class="faq-toggle">+</span>
					</summary>
					<div class="faq-content">
						<p>{faq.answer}</p>
					</div>
				</details>
			))}
		</div>
	</div>
</section>
