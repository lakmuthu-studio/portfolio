---
const steps = [
	{
		number: "1",
		title: "Discuss requirements",
		description: "Tell me what you need, who will use it, and what the first version must include."
	},
	{
		number: "2",
		title: "Approve scope and price",
		description: "I send a written scope, timeline, and price so we agree on the work before it begins."
	},
	{
		number: "3",
		title: "Build and review",
		description: "I build the agreed project and share progress for review at practical milestones."
	},
	{
		number: "4",
		title: "Launch and handover",
		description: "After final approval and payment, I deploy the project and hand over the agreed files and notes."
	}
];
---

<section id="process">
	<div class="wrap">
		<div class="section-head reveal">
			<span class="eyebrow">How Projects Work</span>
			<h2>Four clear steps from idea to handover.</h2>
		</div>

		<div class="steps-grid">
			{steps.map(step => (
				<div class="panel-card reveal">
					<div class="step-number">{step.number}</div>
					<h3>{step.title}</h3>
					<p style="margin-top: 8px; color: var(--ink-soft); font-size: 0.94rem; line-height: 1.5;">{step.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
