---
const steps = [
	{
		number: "1",
		title: "Requirement Discussion",
		description: "We discuss what you need, who will use it, what the project should achieve, and what must be included in the first version."
	},
	{
		number: "2",
		title: "Scope & UI Plan",
		description: "I prepare a written scope, feature list, screen outline, and UI direction before development starts."
	},
	{
		number: "3",
		title: "Client Approval",
		description: "Development starts only after the scope and UI direction are approved. This approval becomes the reference point for the project."
	},
	{
		number: "4",
		title: "Advance Payment",
		description: "Work begins after the agreed advance payment is received."
	},
	{
		number: "5",
		title: "Development",
		description: "I build the project according to the approved scope, with progress updates at agreed milestones."
	},
	{
		number: "6",
		title: "Review & Revisions",
		description: "You review the project and request revisions within the agreed revision scope."
	},
	{
		number: "7",
		title: "Final Payment & Handover",
		description: "After final payment, I hand over the agreed source code, deployment details, documentation, and project files."
	},
	{
		number: "8",
		title: "Post-Launch Bug Support",
		description: "30 days of post-launch bug-fix support is included for issues related to the agreed project scope."
	}
];
---

<section id="process">
	<div class="wrap">
		<div class="section-head reveal">
			<span class="eyebrow">How Projects Work</span>
			<h2>A structured process with clear milestones.</h2>
			<p>I use a simple project workflow designed to avoid confusion, rushed changes, unclear ownership, and unfinished handovers.</p>
		</div>

		<div class="steps-grid">
			{steps.map(step => (
				<div class="panel-card reveal">
					<div class="step-number">{step.number}</div>
					<h3>{step.title}</h3>
					<p style="margin-top: 8px; color: var(--ink-soft); font-size: 0.94rem; line-height: 1.5;">{step.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
