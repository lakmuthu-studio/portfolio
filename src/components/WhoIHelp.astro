---
const checklistItems = [
	"you need a clear, professional public website",
	"manual records or spreadsheets are slowing down the work",
	"you need a first working version of a web or mobile app",
	"you want a properly scoped project with a clean handover"
];
---

<section id="who-i-help">
	<div class="wrap about">
		<div class="about-text reveal">
			<span class="eyebrow">Who I Help</span>
			<h2>Practical software without unnecessary complexity.</h2>
			<p>
				I work with small businesses, founders, service providers, and teams that need clear, reliable digital tools built around real workflows.
			</p>
		</div>

		<div class="panel-card reveal">
			<h3 style="font-size: 1.15rem; color: var(--blue-deep); margin-bottom: 16px;">This is a good fit if:</h3>
			<ul class="check-list">
				{checklistItems.map(item => (
					<li>
						<span class="mark">✓</span>
						<span>{item}</span>
					</li>
				))}
			</ul>
		</div>
	</div>
</section>
