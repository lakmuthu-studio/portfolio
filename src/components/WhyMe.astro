---
const focusPoints = [
	"clear communication — direct contact with the developer",
	"agreed scope and specifications before development",
	"practical business workflows that eliminate manual steps",
	"fast, mobile-friendly interfaces — not bloated templates",
	"maintainable code built for long-term reliability",
	"proper deployment, environment setup, and hosting configuration",
	"structured handover with complete project files",
	"30 days of post-launch bug support included"
];
---

<section id="why-me">
	<div class="wrap about">
		<div class="about-text reveal">
			<span class="eyebrow">Why Work With Me</span>
			<h2>You work directly with the developer building your project.</h2>
			<p>
				No account managers. No handoffs. No confusion about who is responsible for the work.
			</p>
			<p>
				I have professional experience building web and mobile application features, admin panels, backend integrations, and production-ready interfaces.
			</p>
		</div>

		<div class="panel-card reveal">
			<h3 style="margin-bottom: 16px; font-size: 1.15rem; color: var(--blue-deep);">I focus on:</h3>
			<ul class="check-list">
				{focusPoints.map(point => (
					<li>
						<span class="mark">✓</span>
						<span>{point}</span>
					</li>
				))}
			</ul>
		</div>
	</div>
</section>
