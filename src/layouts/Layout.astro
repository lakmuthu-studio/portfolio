---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Lakmuthu Studio — Custom Websites, Dashboards & Apps",
	description = "Lakmuthu Studio — independent web, app, and software development by Kaveen Lakmuthu. Clean, fast websites, dashboards, and custom software for small businesses."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="lakmuthu studio, kaveen lakmuthu, web developer, admin panel developer, custom web apps, mobile app mvp, business website, dashboard developer, sri lanka" />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body id="top">
		<header class="nav">
			<div class="nav-inner">
				<a href="#top" class="brand" aria-label="Lakmuthu Studio, back to top">
					<span class="brand-mark" aria-hidden="true">L</span>
					<span>Lakmuthu Studio</span>
				</a>
				<nav class="links">
					<a href="#who-i-help">Who I Help</a>
					<a href="#services">Services</a>
					<a href="#process">Process</a>
					<a href="#work">Work</a>
					<a href="#faq">FAQ</a>
					<a href="#contact" class="nav-cta">Get in touch</a>
				</nav>
				<a href="#contact" class="mobile-nav-cta">Let’s talk <span aria-hidden="true">→</span></a>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer>
			<div class="wrap footer-content">
				<p>
					<strong>Lakmuthu Studio</strong> — independent web, app, and software development by Kaveen Lakmuthu.
				</p>
				<p class="footer-sub">
					Technical projects and engineering notes: <a href="https://lakmuthu.dev" target="_blank" rel="noopener noreferrer">lakmuthu.dev</a>
				</p>
				<p class="footer-copy">
					&copy; 2026 Kaveen Lakmuthu. Lakmuthu Studio is the independent software service practice of Kaveen Lakmuthu. All rights reserved.
				</p>
			</div>
		</footer>

		<script>
			// Scroll reveal observer
			const revealEls = document.querySelectorAll('.reveal');
			const io = new IntersectionObserver((entries) => {
				entries.forEach(e => {
					if (e.isIntersecting){
						e.target.classList.add('in');
						io.unobserve(e.target);
					}
				});
			}, { threshold: 0.15 });
			revealEls.forEach(el => io.observe(el));
		</script>
	</body>
</html>
