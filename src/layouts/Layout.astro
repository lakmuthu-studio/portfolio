---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = "Lakmuthu Studio — Custom Websites, Dashboards & Apps",
	description = "Lakmuthu Studio — independent web, app, and software development by Kaveen Lakmuthu. Clean, fast websites, dashboards, and custom software for small businesses.",
	image = "/social-card.png",
	noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageURL = new URL(image, Astro.site ?? Astro.url.origin);
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "ProfessionalService",
			"@id": "https://studio.lakmuthu.dev/#business",
			name: "Lakmuthu Studio",
			url: "https://studio.lakmuthu.dev",
			image: socialImageURL.href,
			email: "mailto:kaveensalakmuthu@gmail.com",
			telephone: "+94764982919",
			description,
			founder: { "@id": "https://studio.lakmuthu.dev/#person" },
			areaServed: "Worldwide",
			sameAs: ["https://www.linkedin.com/in/kaveen-lakmuthu"]
		},
		{
			"@type": "Person",
			"@id": "https://studio.lakmuthu.dev/#person",
			name: "Kaveen Lakmuthu",
			url: "https://lakmuthu.dev",
			email: "mailto:kaveensalakmuthu@gmail.com",
			telephone: "+94764982919",
			jobTitle: "Software Developer",
			worksFor: { "@id": "https://studio.lakmuthu.dev/#business" },
			sameAs: ["https://www.linkedin.com/in/kaveen-lakmuthu"]
		}
	]
};
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0B2447" />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="lakmuthu studio, kaveen lakmuthu, web developer, admin panel developer, custom web apps, mobile app mvp, business website, dashboard developer, sri lanka" />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<!-- Social Sharing -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Lakmuthu Studio" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Lakmuthu Studio — custom websites, dashboards and apps" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />
		<meta name="twitter:image:alt" content="Lakmuthu Studio — custom websites, dashboards and apps" />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body id="top">
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<header class="nav">
			<div class="nav-inner">
				<a href="/" class="brand" aria-label="Lakmuthu Studio, home">
					<img class="brand-logo" src="/logo-mark.svg" alt="" width="36" height="36" />
					<span>Lakmuthu Studio</span>
				</a>
				<nav class="links" id="site-navigation" aria-label="Primary navigation">
					<a href="/#who-i-help">Who I Help</a>
					<a href="/#services">Services</a>
					<a href="/#process">Process</a>
					<a href="/#work">Work</a>
					<a href="/#faq">FAQ</a>
					<a href="/#contact" class="nav-cta">Get in touch</a>
				</nav>
				<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
					<span class="sr-only">Open navigation</span>
					<span class="nav-toggle-line" aria-hidden="true"></span>
					<span class="nav-toggle-line" aria-hidden="true"></span>
					<span class="nav-toggle-line" aria-hidden="true"></span>
				</button>
			</div>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer>
			<div class="wrap footer-content">
				<p>
					<strong>Lakmuthu Studio</strong> — independent web, app, and software development by Kaveen Lakmuthu.
				</p>
				<p class="footer-copy">
					&copy; 2026 Kaveen Lakmuthu. Lakmuthu Studio is the independent software service practice of Kaveen Lakmuthu. All rights reserved.
				</p>
				<nav class="footer-links" aria-label="Legal and portfolio links">
					<a href="/privacy-policy/">Privacy Policy</a>
					<span aria-hidden="true">·</span>
					<a href="/service-policy/">Service Policy</a>
					<span aria-hidden="true">·</span>
					<a href="tel:+94764982919">+94 76 498 2919</a>
					<span aria-hidden="true">·</span>
					<a href="https://www.linkedin.com/in/kaveen-lakmuthu" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					<span aria-hidden="true">·</span>
					<a href="https://lakmuthu.dev" target="_blank" rel="noopener noreferrer">Technical Portfolio</a>
				</nav>
			</div>
		</footer>

		<script>
			const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
			const siteNavigation = document.querySelector<HTMLElement>('#site-navigation');
			const closeNavigation = () => {
				siteNavigation?.classList.remove('is-open');
				navToggle?.setAttribute('aria-expanded', 'false');
				const label = navToggle?.querySelector('.sr-only');
				if (label) label.textContent = 'Open navigation';
			};

			navToggle?.addEventListener('click', () => {
				const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
				siteNavigation?.classList.toggle('is-open', !isOpen);
				navToggle.setAttribute('aria-expanded', String(!isOpen));
				const label = navToggle.querySelector('.sr-only');
				if (label) label.textContent = isOpen ? 'Open navigation' : 'Close navigation';
			});
			siteNavigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeNavigation));
			document.addEventListener('pointerdown', event => {
				if (navToggle?.getAttribute('aria-expanded') !== 'true') return;
				const target = event.target;
				if (!(target instanceof Node)) return;
				if (!siteNavigation?.contains(target) && !navToggle?.contains(target)) closeNavigation();
			});
			window.addEventListener('resize', () => {
				if (window.innerWidth > 860) closeNavigation();
			});
			document.addEventListener('keydown', event => {
				if (event.key === 'Escape') closeNavigation();
			});

			// Scroll reveal observer
			const revealEls = document.querySelectorAll('.reveal');
			const io = new IntersectionObserver((entries) => {
				entries.forEach(e => {
					if (e.isIntersecting){
						e.target.classList.add('in');
						io.unobserve(e.target);
					}
				});
			}, { threshold: 0.15 });
			revealEls.forEach(el => io.observe(el));
		</script>
	</body>
</html>
